{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ABU Agent Desktop",
  "version": "0.1.6",
  "identifier": "com.abu.agent",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui",
    "devUrl": "http://localhost:5713",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' http://localhost:5713; connect-src 'self' ipc: http://ipc.localhost http://localhost:5713 ws://localhost:5713 https:; font-src 'self' data:; frame-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "ABU Agent Desktop",
        "width": 392,
        "height": 152,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "create": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "nsis"
    ],
    "externalBin": [
      "binaries/abu-agent-ocr-helper"
    ],
    "resources": {
      "resources/skills": "skills"
    },
    "windows": {
      "wix": {
        "version": "2.8.2"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
